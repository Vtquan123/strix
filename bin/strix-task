#!/usr/bin/env bash
# strix-task — entry point for the Strix task-board CLI.
#
# The implementation lives next to this file in strix-task.mjs. It is an explicit
# ES module so it runs the same on every supported Node, without relying on
# Node's module-syntax detection for an extensionless file.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec node "$HERE/strix-task.mjs" "$@"
