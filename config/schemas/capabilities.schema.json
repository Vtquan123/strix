{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Vtquan123/strix/config/schemas/capabilities.schema.json",
  "title": "Strix capability matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["engines", "access_levels", "capabilities"],
  "definitions": {
    "engineId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "accessLevelId": { "type": "string", "enum": ["owns", "forbidden", "read_only"] }
  },
  "properties": {
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "runtime", "kind"],
        "properties": {
          "id": { "$ref": "#/definitions/engineId" },
          "label": { "type": "string" },
          "runtime": { "type": "string", "enum": ["planning", "execution"] },
          "kind": { "type": "string", "enum": ["reasoning", "implementation"] }
        }
      }
    },
    "access_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "forbidden", "read_only"],
      "patternProperties": {
        "^(owns|forbidden|read_only)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol", "label"],
          "properties": {
            "symbol": { "type": "string", "minLength": 1 },
            "label": { "type": "string" }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "layer", "mode", "access"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string" },
          "layer": { "type": "string" },
          "mode": { "type": "string", "enum": ["exclusive", "shared"] },
          "access": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/definitions/accessLevelId" }
          },
          "constraints": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
