{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Vtquan123/strix/config/schemas/executors.schema.json",
  "title": "Strix selectable executor catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["default", "executors"],
  "definitions": {
    "executorId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  },
  "properties": {
    "default": { "$ref": "#/definitions/executorId" },
    "executors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "template_dir",
          "config_root",
          "skills_dir",
          "rules_format"
        ],
        "properties": {
          "id": { "$ref": "#/definitions/executorId" },
          "label": { "type": "string", "minLength": 1 },
          "template_dir": { "type": "string", "minLength": 1 },
          "config_root": { "type": "string", "minLength": 1 },
          "skills_dir": { "type": "string", "minLength": 1 },
          "catalog": { "type": "string" },
          "rules_format": { "type": "string", "minLength": 1 },
          "skills_agent": { "type": ["string", "null"] },
          "handoff": { "type": "string" }
        }
      }
    }
  }
}
