{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Vtquan123/strix/config/schemas/task-schema.schema.json",
  "title": "Strix task record schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["header_fields", "body_sections", "lifecycle"],
  "properties": {
    "header_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "meaning"],
        "properties": {
          "name": { "type": "string" },
          "meaning": { "type": "string" },
          "placeholder": { "type": "string" },
          "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "enum_from": {
            "type": "string",
            "enum": ["routing.complexity_levels"],
            "description": "Pull the enum from another config file instead of listing it here."
          }
        }
      }
    },
    "body_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "meaning"],
        "properties": {
          "name": { "type": "string" },
          "meaning": { "type": "string" }
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status"],
        "properties": {
          "stage": { "type": "string", "pattern": "^[a-z]+$" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
