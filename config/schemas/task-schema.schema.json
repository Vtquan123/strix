{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Vtquan123/strix/config/schemas/task-schema.schema.json",
  "title": "Strix task record schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header_fields",
    "body_sections",
    "lifecycle",
    "transitions",
    "board"
  ],
  "properties": {
    "header_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "meaning"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "enum": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "enum_from": {
            "type": "string",
            "enum": [
              "routing.complexity_levels"
            ],
            "description": "Pull the enum from another config file instead of listing it here."
          }
        }
      }
    },
    "body_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "meaning"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "lite": {
            "type": "boolean",
            "description": "Kept in a TRIVIAL task made with `strix-task new --lite`."
          },
          "note": {
            "type": "string",
            "pattern": "^[a-z]+$",
            "description": "Written only through `strix-task note`, while the task is in this stage."
          },
          "cli": {
            "type": "boolean",
            "description": "Written only by strix-task itself."
          }
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "status"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "description": "The moves strix-task allows without --override.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "label",
          "owner",
          "meaning"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "enum": [
              "ready",
              "reported",
              "checklist"
            ]
          },
          "reason": {
            "type": "boolean"
          },
          "owner": {
            "type": "string",
            "enum": [
              "orchestrator",
              "executor",
              "reviewer"
            ]
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "description": "Board layout: tasks are grouped by workstream inside each stage.",
      "required": [
        "path",
        "default_workstream",
        "registry"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "{stage}/{workstream}/{id}-{slug}.md",
          "description": "A task's location, relative to .strix/tasks/."
        },
        "default_workstream": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Reserved bucket for tasks belonging to no EPIC."
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*\\.yaml$",
          "description": "Registry filename, relative to .strix/tasks/."
        }
      }
    }
  }
}
