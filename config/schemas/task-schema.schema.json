{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Vtquan123/strix/config/schemas/task-schema.schema.json",
  "title": "Strix task record schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["header_fields", "body_sections", "lifecycle", "board"],
  "properties": {
    "header_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "meaning"],
        "properties": {
          "name": { "type": "string" },
          "meaning": { "type": "string" },
          "placeholder": { "type": "string" },
          "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "enum_from": {
            "type": "string",
            "enum": ["routing.complexity_levels"],
            "description": "Pull the enum from another config file instead of listing it here."
          }
        }
      }
    },
    "body_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "meaning"],
        "properties": {
          "name": { "type": "string" },
          "meaning": { "type": "string" }
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status"],
        "properties": {
          "stage": { "type": "string", "pattern": "^[a-z]+$" },
          "status": { "type": "string" }
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "description": "Board layout: tasks are grouped by workstream inside each stage.",
      "required": ["path", "default_workstream", "registry"],
      "properties": {
        "path": {
          "type": "string",
          "const": "{stage}/{workstream}/{id}.md",
          "description": "A task's location, relative to .strix/tasks/."
        },
        "default_workstream": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Reserved bucket for tasks belonging to no EPIC."
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*\\.yaml$",
          "description": "Registry filename, relative to .strix/tasks/."
        }
      }
    }
  }
}
