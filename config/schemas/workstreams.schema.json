{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Vtquan123/strix/config/schemas/workstreams.schema.json",
  "title": "Strix workstream registry",
  "description": "Shape of .strix/tasks/workstreams.yaml. Deliberately flat so strix-task can parse it without a YAML dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workstreams"],
  "properties": {
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prefix", "owner", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" },
          "owner": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["active", "closed"] }
        }
      }
    }
  }
}
